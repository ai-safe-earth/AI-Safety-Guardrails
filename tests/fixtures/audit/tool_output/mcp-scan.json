                "type": "object",
                "properties": {
                  "title": {"type": "string"},
                  "body": {"type": "string"}
                },
                "required": ["title", "body"]
              }
            },
            {
              "name": "list_notes",
              "description": "List the titles of saved notes.",
              "inputSchema": {"type": "object", "properties": {}}
            }
          ]
        },
        "result": [
          {"type": "tool", "name": "add_note", "status": "failed"},
          {"type": "tool", "name": "list_notes", "status": "verified"}
        ],
        "error": null
      }
    ],
    "issues": [
      {
        "code": "W001",
