# .env.example
# -------------------------------------------------------
# AI Safety Guardrails — Environment Configuration
# -------------------------------------------------------
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# .env is gitignored by default — never commit real keys.
# All variables are optional; the library works without them
# (features that need a key are simply disabled or use a fallback).
#
# Variable names are case-insensitive.
# -------------------------------------------------------


# =======================================================
# 1. RUNTIME ENVIRONMENT
# =======================================================

# Active environment: development | staging | production | test
# Controls defaults for fail_open, log verbosity, etc.
GUARDRAILS_ENV=development

# Path to the active pipeline YAML config
GUARDRAILS_CONFIG_PATH=config/default.yaml

# Fail-open: when True, guardrail errors let traffic through unfiltered.
# Safe during development; NEVER set True in production.
GUARDRAILS_FAIL_OPEN=false

# Per-request timeout (seconds) for the LLM callable in run_full().
# 0 disables the timeout. Set to a finite value in production.
GUARDRAILS_REQUEST_TIMEOUT=30.0

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
GUARDRAILS_LOG_LEVEL=INFO


# =======================================================
# 2. API KEYS — LLM PROVIDERS
# =======================================================

# Anthropic — used by ClaudeJudge and the optional LLM-as-judge in guards.
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq — fastest LlamaGuard 3 provider (~100ms). Recommended for production.
# Get your key at: https://console.groq.com/
GROQ_API_KEY=

# Together AI — alternative LlamaGuard 3 provider.
# Get your key at: https://api.together.xyz/
TOGETHER_API_KEY=

# OpenAI — used by OpenAIModerationJudge (free moderation endpoint).
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=

# Google Perspective API — used by ToxicityFilter when use_perspective=True.
# Get your key at: https://developers.perspectiveapi.com/
PERSPECTIVE_API_KEY=

# Azure Content Safety — used by ToxicityFilter when use_azure=True.
AZURE_CONTENT_SAFETY_KEY=
AZURE_CONTENT_SAFETY_ENDPOINT=


# =======================================================
# 3. LLM JUDGE DEFAULTS
# =======================================================

# Default judge type when loading guards from YAML config.
# Options: llamaguard | openai_mod | claude
DEFAULT_JUDGE_TYPE=llamaguard

# Default LlamaGuard provider.
# Options: groq | together | ollama | openai | huggingface
DEFAULT_JUDGE_PROVIDER=groq

# Timeout (seconds) for LLM judge API calls.
DEFAULT_JUDGE_TIMEOUT=10.0

# Fail-open for judge calls: True = pass on judge error, False = block on judge error.
# High-risk tools (send_email, shell_command, etc.) always block on judge failure
# regardless of this setting (controlled by high_risk_fail_closed in tool filter).
DEFAULT_JUDGE_FAIL_OPEN=true

# Local Ollama server URL (used when DEFAULT_JUDGE_PROVIDER=ollama).
# Run Ollama: https://ollama.ai/  then: ollama pull llama-guard3
OLLAMA_BASE_URL=http://localhost:11434


# =======================================================
# 4. POLICY MODULES
# =======================================================

# --- EU AI Act (Regulation 2024/1689) ---

# Unique identifier for your AI system (appears in audit logs and disclosures).
EU_AI_ACT_SYSTEM_ID=my-ai-system

# Your organisation name (shown in Art. 13/50 transparency disclosures).
EU_AI_ACT_PROVIDER_NAME=My Organization

# Risk tier: unacceptable | high | limited | minimal
EU_AI_ACT_RISK_TIER=limited

# Path for Art. 12 tamper-evident audit log.
EU_AI_ACT_AUDIT_LOG_PATH=audit/eu_ai_act.jsonl

# Audit log retention period in days (minimum 365 for high-risk systems).
EU_AI_ACT_AUDIT_RETENTION_DAYS=365

# --- NIST AI Risk Management Framework (AI RMF 1.0) ---

NIST_SYSTEM_NAME=my-ai-system
NIST_OPERATOR_NAME=My Organization

# Impact level: critical | high | moderate | low
NIST_IMPACT_LEVEL=moderate

# Path for MANAGE 2.4 monitoring log.
NIST_AUDIT_LOG_PATH=audit/nist_ai_rmf.jsonl


# =======================================================
# 5. AUDIT & OBSERVABILITY
# =======================================================

# Base directory for all audit log files.
GUARDRAILS_AUDIT_LOG_DIR=audit

# OpenTelemetry OTLP endpoint. Leave empty to disable tracing export.
# Example: http://localhost:4317  (local Jaeger / Tempo)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name reported in traces and metrics.
OTEL_SERVICE_NAME=ai-safety-guardrails

# Prometheus metrics server.
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090


# =======================================================
# 6. EXTERNAL INTEGRATIONS
# =======================================================

# Enable LangChain callback handler.
LANGCHAIN_ENABLED=false

# Enable FastAPI middleware.
FASTAPI_ENABLED=false


# =======================================================
# 7. DEVELOPMENT / TEST HELPERS
# =======================================================
# WARNING: never set these to true in production.

# Disable ALL guardrails globally. Local development only.
GUARDRAILS_DISABLE_ALL=false

# Return safe=True for all LLM judge calls (no API calls in unit tests).
GUARDRAILS_MOCK_JUDGES=false
